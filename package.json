{
  "name": "kamacafe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "validate:catalog": "tsx scripts/validate-catalog.ts",
    "validate:social": "tsx scripts/validate-social-metadata.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "build": "npm run validate:catalog && npm run typecheck && vite build && npm run validate:social",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:performance": "lhci autorun --config=tests/performance/lighthouserc.json"
  },
  "dependencies": {
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.55.0",
    "@preact/preset-vite": "^2.10.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
