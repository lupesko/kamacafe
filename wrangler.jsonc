{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kamacafe",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  },
  "routes": [
    {
      "pattern": "kamacafe.lupesko.com",
      "custom_domain": true
    }
  ]
}
