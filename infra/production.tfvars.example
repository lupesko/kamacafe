site_hostname           = "coffee.example.com"
aws_region              = "us-west-2"
cloudflare_zone_id      = "00000000000000000000000000000000"
github_repository       = "lupesko/kamacafe"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
asset_cache_seconds     = 86400
terraform_state_bucket  = "replace-with-encrypted-versioned-state-bucket"
terraform_state_key     = "kamacafe/production.tfstate"
terraform_state_region  = "us-west-2"

common_tags = {
  Project     = "KamaCafe"
  Environment = "production"
  ManagedBy   = "Terraform"
}
